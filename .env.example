# GoHighLevel Private Integration token (Settings → Private Integrations)
GHL_API_KEY=your_ghl_private_integration_token
GHL_LOCATION_ID=your_location_id

# Webhook verification — set at least one:
# Marketplace app webhooks: GHL's RSA public key (x-wh-signature). Use \n for line breaks.
GHL_WEBHOOK_PUBLIC_KEY=
# Custom/workflow webhooks: shared HMAC-SHA256 secret sent as x-ghl-signature
GHL_WEBHOOK_SECRET=your_webhook_secret
# Only for local testing
ALLOW_UNSIGNED=false

# Automation settings
GHL_ONBOARDING_WORKFLOW_ID=
GHL_WON_STAGE_ID=
GHL_LOST_STAGE_ID=
NEW_LEAD_TAGS=new-lead,webhook-processed

# GET /logs requires this key in the X-API-Key header
LOGS_API_KEY=change_me

# DRY_RUN=true logs the CRM actions instead of calling the API
DRY_RUN=false
PORT=3000
